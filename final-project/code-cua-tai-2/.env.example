# Backend-only configuration. Never expose these values to the browser.
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT=30

# Local service ports (chosen to avoid common shared-dev conflicts)
WEB_PORT=8080
API_PORT=18000
POSTGRES_PORT=55433
REDIS_PORT=56379
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:4173,http://localhost:8080
VITE_API_URL=http://localhost:18000
